<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fitsSystemWindows="true"
    tools:context=".Home.pertemuan_9.NinthActivity">

    <FrameLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_header_wave" />

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarNinth"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:title="Materi Pertemuan 9"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat Datang di Pertemuan 9"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textColor="#2D3142"
                android:letterSpacing="-0.01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Silahkan login untuk mengakses materi lengkap."
                android:textSize="14sp"
                android:textColor="#9E9E9E"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="32dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email Address"
                app:boxStrokeColor="#634E9E"
                app:hintTextColor="#634E9E"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:startIconDrawable="@drawable/ic_edit"
                app:startIconTint="#634E9E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="#2D3142" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutPass"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Password"
                app:boxStrokeColor="#634E9E"
                app:hintTextColor="#634E9E"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="#634E9E"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="#634E9E">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="#2D3142" />
            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Masuk ke Materi"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                app:backgroundTint="#634E9E"
                android:textColor="@color/white"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_login"
                app:iconGravity="textStart"
                app:iconPadding="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="40dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Filter Berdasarkan Kategori"
                android:textSize="15sp"
                android:textColor="#2D3142"
                android:fontFamily="sans-serif-medium"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTerbaru"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Terbaru"
                    app:chipBackgroundColor="@color/bg_soft_blue"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPenting"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penting"
                    app:chipStrokeColor="#E0E0E0" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBelumDibaca"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum Dibaca"
                    app:chipStrokeColor="#E0E0E0" />

            </com.google.android.material.chip.ChipGroup>

            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:columnCount="3"
                app:useDefaultMargins="true">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:text="Menu 1"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_add_circle"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconPadding="4dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="12dp"
                    android:textColor="#634E9E"
                    app:iconTint="#634E9E"
                    app:strokeColor="#634E9E" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:text="Menu 2"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_add_circle"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconPadding="4dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="12dp"
                    android:textColor="#634E9E"
                    app:iconTint="#634E9E"
                    app:strokeColor="#634E9E" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:text="Menu 3"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_add_circle"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconPadding="4dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="12dp"
                    android:textColor="#634E9E"
                    app:iconTint="#634E9E"
                    app:strokeColor="#634E9E" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:text="Menu 4"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_add_circle"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconPadding="4dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="12dp"
                    android:textColor="#634E9E"
                    app:iconTint="#634E9E"
                    app:strokeColor="#634E9E" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:text="Menu 5"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_add_circle"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconPadding="4dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="12dp"
                    android:textColor="#634E9E"
                    app:iconTint="#634E9E"
                    app:strokeColor="#634E9E" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="85dp"
                    android:text="Menu 6"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_add_circle"
                    app:iconGravity="top"
                    app:iconSize="26dp"
                    app:iconPadding="4dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal"
                    app:cornerRadius="12dp"
                    android:textColor="#634E9E"
                    app:iconTint="#634E9E"
                    app:strokeColor="#634E9E" />

            </androidx.gridlayout.widget.GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>